@* Bonus 4 *@
@model int
@{
    ViewData["Title"] = Model == 404 ? "Not found" : "Error";
}

@if (Model == 404)
{
    <h1>Page not found</h1>
    <p>The page or hero you are looking for does not exist.</p>
}
else
{
    <h1>Something went wrong</h1>
    <p>Status code: @Model</p>
}

<p><a asp-controller="Heroes" asp-action="Index">Back to heroes</a></p>
