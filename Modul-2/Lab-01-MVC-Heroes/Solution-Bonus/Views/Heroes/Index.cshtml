@model IReadOnlyList<HeroListItemViewModel>
@{
    ViewData["Title"] = "Heroes";
    var search = Context.Request.Query["search"].ToString();
}

<h1>Registered heroes</h1>

@* Bonus 3: GET, because searching does not change state *@
<form method="get">
    <input name="search" value="@search" />
    <button type="submit">Search</button>
</form>

@if (Model.Count == 0)
{
    <p>@(string.IsNullOrWhiteSpace(search) ? "No registered heroes yet." : "No registered heroes match the search.")</p>
}
else
{
    <ul>
        @foreach (var hero in Model)
        {
            <partial name="_HeroListItem" model="hero" />
        }
    </ul>
}
