@model IReadOnlyList<HeroListItemViewModel>
@{
    ViewData["Title"] = "Drafts";
}

<h1>Draft heroes</h1>
<p>Drafts are not public. Only a Draft can be edited.</p>

@if (TempData["Message"] is string message)
{
    <p role="status">@message</p>
}

@if (Model.Count == 0)
{
    <p>No drafts.</p>
}
else
{
    <ul>
        @foreach (var hero in Model)
        {
            <li>@hero.Codename — <a asp-action="Edit" asp-route-id="@hero.Id">edit</a></li>
        }
    </ul>
}
