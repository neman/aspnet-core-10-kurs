@model IReadOnlyList<HeroListItemViewModel>
@{
    ViewData["Title"] = "Drafts";
}

<h1>Draft heroes</h1>

@if (TempData["Message"] is string message)
{
    <p role="status">@message</p>
}

@if (Model.Count == 0)
{
    <p>No drafts.</p>
}
else
{
    <ul>
        @foreach (var hero in Model)
        {
            <li>
                @hero.Codename
                <form asp-action="Register" asp-route-id="@hero.Id" method="post" style="display: inline">
                    <button type="submit">Register</button>
                </form>
                <form asp-action="Delete" asp-route-id="@hero.Id" method="post" style="display: inline">
                    <button type="submit">Delete</button>
                </form>
            </li>
        }
    </ul>
}
