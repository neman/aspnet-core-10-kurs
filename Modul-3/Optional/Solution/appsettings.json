{
  "ConnectionStrings": {
    "HeroRegistry": "Server=(localdb)\\MSSQLLocalDB;Database=HeroRegistry;Trusted_Connection=True",
    "HeroRegistrySqlite": "Data Source=HeroRegistry.db"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "RegistrationRules": {
    "ForbiddenPhrases": [
      "tragic past",
      "chosen one",
      "mysterious organization",
      "secret lab accident"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
