@model IReadOnlyList<HeroListItemViewModel>
@{
    ViewData["Title"] = "My drafts";
}

<h1>My drafts</h1>
<p>Heroes you created that are not Registered yet. Only you can see them here.</p>
<p><a asp-action="Create">New hero</a></p>

@if (TempData["Message"] is string message)
{
    <p role="status">@message</p>
}

@if (Model.Count == 0)
{
    <p>No drafts yet.</p>
}

<ul>
    @foreach (var hero in Model)
    {
        <li>@hero.Codename</li>
    }
</ul>
